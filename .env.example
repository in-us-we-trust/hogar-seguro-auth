# Auth service local environment template
# Copy this file to .env and replace values as needed.

# Server
AUTH_PORT=8081

# Database (PostgreSQL example)
DB_URL=jdbc:postgresql://localhost:5432/authdb
DB_USERNAME=auth
DB_PASSWORD=secret
DB_DRIVER=org.postgresql.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# JWT
JWT_SECRET=replace_with_a_secret_of_at_least_32_characters
JWT_EXPIRATION_MS=3600000

# Email
EMAIL_PROVIDER=dummy
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_NAME="Hogar Seguro"
BREVO_SENDER_EMAIL=

# Frontend/app URL for password reset links
APP_RESET_PASSWORD_URL=https://hogar-seguro.app/reset-password
